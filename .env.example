# Copy to .env. Compose overrides the service URLs and S3 keys for its containers;
# the values here are for running the backend on the host with `uv run`.

DATABASE_URL=postgresql+psycopg://classlop:classlop@localhost:5432/classlop
OPENSEARCH_URL=http://localhost:9200

AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev
S3_BUCKET=classlop
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_ENDPOINT_URL=
SQS_ENDPOINT_URL=http://localhost:9324

# The team's OpenAI-compatible endpoint; LLM_MODELS overrides the chat model per job key,
# e.g. {"grading.transcribe": "gpt-5.4-mini"}.
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-5.4-mini
LLM_EMBEDDING_MODEL=text-embedding-ada-002
LLM_MODELS={}

LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=classlop

# Written by scripts/setup-demo-tenant.sh
M365_TENANT_KIND=
M365_TENANT_DOMAIN=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLASS_NAME=
M365_CLASS_ID=
M365_TEACHER_UPN=
M365_TEACHER_PASSWORD=
M365_STUDENT_UPNS=
M365_STUDENT_PASSWORDS=
